# Copie para .env (fora do git) e ajuste. Variáveis já definidas no ambiente têm prioridade.

# Obrigatório. Gere com: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
AGATHA_TOKEN=

# AGATHA_HOST=0.0.0.0
# AGATHA_PORT=8765
# AGATHA_LOG_LEVEL=INFO

# STT (ADR-002)
# AGATHA_STT_MODEL=small
# AGATHA_STT_DEVICE=cuda
# AGATHA_STT_COMPUTE_TYPE=int8
# AGATHA_STT_BEAM_SIZE=1
# AGATHA_STT_LANGUAGE=pt
# AGATHA_STT_MODELS_DIR=/dados/agatha/models/whisper
# AGATHA_STT_INITIAL_PROMPT=Agatha, Zabbix, Oracle, trigger, tablespace, Linux, Podman

# VAD (docs/protocol.md)
# AGATHA_VAD_THRESHOLD=0.5
# AGATHA_VAD_MIN_SILENCE_MS=500
# AGATHA_VAD_PRE_ROLL_MS=300
# AGATHA_VAD_MIN_SPEECH_MS=250
# AGATHA_VAD_MAX_SEGMENT_S=25

# LLM (ADR-004): llama-server no container agatha-llm (deploy/llama/run-llm.sh)
# AGATHA_LLM_URL=http://127.0.0.1:8080
# AGATHA_LLM_TEMPERATURE=0.6
# AGATHA_LLM_MAX_TOKENS=200
# AGATHA_HISTORY_TURNS=6

# TTS (ADR-005)
# AGATHA_TTS_VOICE=/dados/agatha/models/tts/piper/dii_pt-BR.onnx
# AGATHA_TTS_LENGTH_SCALE=1.0
# AGATHA_TTS_THREADS=3
